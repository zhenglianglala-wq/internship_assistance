# Copy to .env locally. Never commit .env or .data/.
PORT=4318
DATA_DIR=.data
# Optional display brand name for server-side pages and IMAP client identity.
APP_DISPLAY_NAME=lalaliang
# Optional OpenAI-compatible chat-completions provider; key is server-side only.
AI_PROVIDER=bailian
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional LLM observability: traces + token usage are sent to Langfuse (cloud default https://cloud.langfuse.com).
# Create keys at the Langfuse project settings. Leave keys empty to disable tracing entirely.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Register your own OAuth applications to enable one-click authorization.
# Redirect URIs: http://localhost:4318/api/oauth/google/callback
#                http://localhost:4318/api/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# Optional Chrome/Chromium executable; resumes use bundled fonts.
BOSS_CHROME_PATH=
